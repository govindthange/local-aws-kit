flowchart LR

    %% COLORS & STYLES %%
    classDef hostStyle fill:#eaf6f8,stroke:#a3d5dc,stroke-width:2px,color:#000000;
    classDef flociStyle fill:#cdeee7,stroke:#7fcdbb,stroke-width:2px,color:#000000;
    classDef kindStyle fill:#dff3ef,stroke:#a8ddd0,stroke-width:2px,color:#000000;
    classDef k3sStyle fill:#e6f2f7,stroke:#9dc6d9,stroke-width:2px,color:#000000;
    classDef dbStyle fill:#fff3cd,stroke:#ffeeba,stroke-width:2px,color:#000000;
    classDef clientStyle fill:#e2e3e5,stroke:#d6d8db,stroke-width:2px,color:#000000;
    classDef netStyle fill:#f0f9fb,stroke:#b8dde3,stroke-width:1px,stroke-dasharray: 5 5,color:#000000;
    classDef stackStyle fill:#e3f4f7,stroke:#a3d5dc,stroke-width:1px,color:#000000;
    classDef hostNodeStyle fill:#eaf6f8,stroke:#a3d5dc,stroke-width:2px,color:#000000;

    subgraph Host ["💻 HOST MACHINE / DEVELOPER WORKSPACE"]
        
        UI["🖥️ Web Browser UI<br/>(:4500 Dashboard | :8081 DocDB | :8082 RDS)"]
        KUBECTL["🔧 kubectl CLI<br/>(Context: kind-local-eks)"]
        
        subgraph NetBridge ["🌐 Shared Docker Network Bridge: local-aws-net"]
            
            %% IAC ENGINE %%
            subgraph Stack2 ["📦 IaC Engine"]
                TF["🏗️ Terraform / AWS CLI Runner"]
            end

            %% FLOCI EMULATOR BACKEND %%
            subgraph Stack1 ["📦 Local AWS Cloud Emulator"]
                FLOCI["⚡ Floci Emulator Container<br/>(floci/floci:latest | Port 4566)"]
                DASH["📊 Floci Dashboard UI<br/>(floci-ui:latest | Port 4500)"]
                
                subgraph FlociServices ["Emulated AWS Metadata & Core Services"]
                    S3["🪣 S3 Bucket<br/>(application-assets)"]
                    REDIS["⚡ ElastiCache Redis<br/>(local-cache)"]
                    KMS["🔑 KMS Key"]
                    EC2["💻 EC2 Instance"]
                    META_RDS["📝 RDS/DocDB Metadata Registry"]
                end
            end

            %% DEDICATED SEPARATE DATABASE CONTAINERS %%
            subgraph StackDB ["🛢️ Separate Dedicated Database Containers"]
                subgraph RDS_Tier ["Tier 3 & 4: AWS RDS Aurora MySQL"]
                    MYSQL["🐬 local-mysql-engine<br/>(mysql:8.0 | Port 3306)"]
                    ADMINER["🖥️ aws-rds-web-client<br/>(adminer:latest | Port 8082)"]
                end
                
                subgraph DOCDB_Tier ["Tier 5 & 6: AWS DocumentDB Engine"]
                    MONGO["🍃 local-mongo-cluster<br/>(mongo:6.0 | Port 27017)"]
                    EXPRESS["🖥️ aws-docdb-web-client<br/>(mongo-express:latest | Port 8081)"]
                end
            end

            %% FLOCI AUTO-SPAWNED K3S %%
            subgraph FlociEKS ["⚡ Floci Native EKS Runtime"]
                K3S["☸️ Dynamic k3s Container<br/>(rancher/k3s)"]
            end

            %% KIND CLUSTER %%
            subgraph KinD ["☸️ KinD Cluster (local-eks)"]
                PLANE["🎮 Control Plane Node"]
                WORKERS["⚙️ Worker Nodes & Application Pods"]
            end

        end
    end

    %% RELATIONSHIPS AND FLOWS %%
    UI ==>|AWS UI| DASH
    UI ==>|DocDB UI| EXPRESS
    UI ==>|RDS UI| ADMINER
    
    KUBECTL ==>|Deploys & Controls| PLANE
    
    TF ==>|1. Applies Terraform / CLI API Calls| FLOCI
    FLOCI -->|2. Registers API State & Metadata| FlociServices
    
    FLOCI ==>|3. Spawns EKS Control Plane| K3S
    
    PLANE --- WORKERS

    %% DB UI DEPENDENCIES & DATA FLOWS %%
    ADMINER -->|Connects to| MYSQL
    EXPRESS -->|Connects to| MONGO

    WORKERS -.->|AWS API Calls :4566| FLOCI
    WORKERS -.->|Direct DB Connection :3306| MYSQL
    WORKERS -.->|Direct DB Connection :27017| MONGO

    %% APPLY CLASSES %%
    class Host hostStyle;
    class TF terraformStyle;
    class FLOCI,DASH,S3,REDIS,KMS,EC2,META_RDS flociStyle;
    class MYSQL,MONGO dbStyle;
    class ADMINER,EXPRESS clientStyle;
    class PLANE,WORKERS kindStyle;
    class K3S k3sStyle;
    class NetBridge netStyle;
    class Stack1,Stack2,StackDB,FlociServices,FlociEKS,KinD,RDS_Tier,DOCDB_Tier stackStyle;
    class UI,KUBECTL hostNodeStyle;