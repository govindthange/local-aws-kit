  'theme': 'base',
  'themeVariables': {
    'primaryColor': '#1d212a',
    'primaryTextColor': '#ffffff',
    'primaryBorderColor': '#434c5e',
    'lineColor': '#88c0d0',
    'fontFamily': 'arial'
