flowchart TB

    %% COLORS & STYLES %%
    classDef terraformStyle fill:#B9EDDE,stroke:#8fbcbb,stroke-width:2px,color:#2e3440;
    classDef hostStyle fill:#eaf6f8,stroke:#a3d5dc,stroke-width:2px,color:#000000;
    classDef flociStyle fill:#FFFCD1,stroke:#d6bbf15,stroke-width:2px,color:#000000;
    classDef dbStyle fill:#cdeee7,stroke:#7fcdbb,stroke-width:2px,color:#000000;
    classDef kindStyle fill:#dff3ef,stroke:#a8ddd0,stroke-width:2px,color:#000000;
    classDef k3sStyle fill:#e6f2f7,stroke:#9dc6d9,stroke-width:2px,color:#000000;
    classDef netStyle fill:#f0f9fb,stroke:#b8dde3,stroke-width:1px,stroke-dasharray: 5 5,color:#000000;
    classDef stackStyle fill:#e3f4f7,stroke:#a3d5dc,stroke-width:1px,color:#000000;
    classDef clientStyle fill:#DBFBFF,stroke:#d6d8db,stroke-width:2px,color:#000000;
    classDef hostNodeStyle fill:#A3E2F0,stroke:#a3d5dc,stroke-width:2px,color:#000000;
    classDef controlPlane fill:#cdeee7,stroke:#7fcdbb,stroke-width:2px,color:#000000;
    classDef workerNode fill:#dff3ef,stroke:#a8ddd0,stroke-width:2px,color:#000000;
    classDef pod fill:#ffe082,stroke:#ffb300,stroke-width:2px;

    subgraph Host ["💻 HOST MACHINE / DEVELOPER WORKSPACE"]
        
        UI[/"🖥️ Web Browser UI<br/>(http://localhost:4500)"\]
        KUBECTL[/"🔧 kubectl CLI<br/>(Context: kind-local-eks)"\]
        ADMINER_UI[/"🖥️ Adminer RDS Explorer<br/>(http://localhost:8082)"\]
        EXPRESS_UI[/"🖥️ Mongo Express Explorer<br/>(http://localhost:8081)"\]
        
        subgraph NetBridge ["🌐 Shared Docker Network Bridge: local-aws-net"]
            
            %% STACK 2: TERRAFORM %%
            subgraph Stack2 ["📦 IaC Provisioning Engine"]
                TF["🏗️ Terraform Runner Container<br/>(hashicorp/terraform:1.6.2)"]
            end

            %% STACK 1: FLOCI BACKEND %%
            subgraph Stack1 ["📦 Local AWS Cloud Emulator Core"]
                FLOCI["⚡ AWS Emulator Container<br/>(floci/floci:latest | Port 4566)"]
                DASH["📊 AWS Dashboard UI<br/>(floci/floci-ui:latest | Port 4500)"]
                
                subgraph FlociServices ["Native Emulated Services"]
                    S3["🪣 S3 Bucket<br/>(application-assets)"]
                    REDIS["⚡ ElastiCache Redis<br/>(local-cache)"]
                    KMS["🔑 KMS Key"]
                    EC2["💻 EC2 Instance<br/>(LocalComputeNode)"]
                end
            end

            %% DEDICATED DATABASE CONTAINERS %%
            subgraph DBEngines ["📦 Dedicated Database Containers"]
                subgraph RDS_Tier ["AWS RDS Aurora MySQL Tier"]
                    MYSQL["🐬 MySQL Engine Container<br/>(mysql:8.0 | Port 3306)"]
                    ADMINER["🔌 Adminer DB Explorer<br/>(adminer:latest | Port 8080)"]
                end
                
                subgraph DOCDB_Tier ["AWS DocumentDB Tier"]
                    MONGO["🍃 Mongo Engine Container<br/>(mongo:6.0 | Port 27017)"]
                    EXPRESS["🔌 Mongo Express Explorer<br/>(mongo-express:latest | Port 8081)"]
                end
            end

            %% FLOCI AUTO-SPAWNED K3S %%
            subgraph FlociEKS ["⚡ AWS Native EKS Runtime"]
                K3S["☸️ Dynamic k3s Container<br/>(rancher/k3s)"]
            end

            %% EXPANDED KIND CLUSTER (Integrating kind.v2.mmd) %%
            subgraph KinD ["☸️ KinD Cluster (local-eks)"]
                
                INGRESS["🔀 NGINX Ingress Controller<br/>(Ports 80 / 443)"]

                subgraph Control_Plane ["Control Plane Node (local-eks-control-plane)"]
                    APIServer["kube-apiserver<br/>(Core Hub)"]
                    Etcd[("etcd<br/>(State Store)")]
                    Scheduler["kube-scheduler<br/>(Pod Placement)"]
                    KCM["kube-controller-manager<br/>(State Loops)"]
                    CCM["cloud-controller-manager<br/>(Cloud APIs)"]
                    
                    APIServer <--> Etcd
                    APIServer <-->|Watches/Binds| Scheduler
                    APIServer <-->|Controls| KCM
                    APIServer <-->|Syncs| CCM
                end

                subgraph Worker_Node_1 ["Worker Node 1 (local-eks-worker)"]
                    Kubelet1["kubelet<br/>(Node Agent)"]
                    KProxy1["kube-proxy<br/>(Network Agent)"]
                    CRI1["Container Runtime<br/>(containerd / CRI-O)"]
                    
                    subgraph Pod1 ["Pod"]
                        Container1["App Container"]
                    end

                    Kubelet1 -- CRI --> CRI1
                    CRI1 -- Deploys --> Container1
                    KProxy1 -- Directs Traffic --> Pod1
                end

                subgraph Worker_Node_2 ["Worker Node 2 (local-eks-worker2)"]
                    Kubelet2["kubelet"]
                    KProxy2["kube-proxy"]
                    CRI2["Container Runtime"]
                    
                    subgraph Pod2 ["Pod"]
                        Container2["App Container"]
                    end

                    Kubelet2 -- CRI --> CRI2
                    CRI2 -- Deploys --> Container2
                    KProxy2 -- Directs Traffic --> Pod2
                end

                %% Ingress Routing into Cluster Services %%
                INGRESS -->|Routes Traffic| KProxy1
                INGRESS -->|Routes Traffic| KProxy2

                %% Internal Control Connections %%
                APIServer <-->|Syncs State| Kubelet1
                APIServer <-->|Syncs State| Kubelet2
                APIServer <-->|Network Policies| KProxy1
                APIServer <-->|Network Policies| KProxy2
            end

            %% FORCE STRICT TOP-TO-BOTTOM STACKING %%
            Stack2 ~~~ Stack1
            Stack1 ~~~ DBEngines
            DBEngines ~~~ FlociEKS
            FlociEKS ~~~ KinD

        end
    end

    %% RELATIONSHIPS AND FLOWS %%
    UI ==>|Visualizes AWS State| DASH
    ADMINER_UI -.->|Connects via Web| ADMINER
    EXPRESS_UI -.->|Connects via Web| EXPRESS
    
    DASH -->|Queries Endpoint| FLOCI
    KUBECTL ==>|Deploys & Controls| APIServer
    
    TF ==>|1. Applies provider.tf to :4566| FLOCI
    FLOCI -->|2. Registers API Metadata| S3 & REDIS & KMS & EC2
    FLOCI ==>|Registers Metadata| MYSQL
    FLOCI ==>|Registers Metadata| MONGO

    ADMINER -->|Connects to| MYSQL
    EXPRESS -->|Connects to| MONGO
    
    FLOCI ==>|3. Spawns EKS Control Plane via Docker Socket| K3S

    %% External & Application Pod Traffic Flows %%
    Container1 -->|4. Calls AWS Control Plane| FLOCI
    Container2 -->|4. Calls AWS Control Plane| FLOCI

    %% APPLY CLASSES %%
    class Host hostStyle;
    class TF terraformStyle;
    class FLOCI,S3,REDIS,KMS,EC2 flociStyle;
    class ADMINER,EXPRESS,DASH clientStyle;
    class MYSQL,MONGO dbStyle;
    class K3S k3sStyle;
    class NetBridge netStyle;
    class Stack1,Stack2,FlociServices,DBEngines,RDS_Tier,DOCDB_Tier,FlociEKS,KinD stackStyle;
    class UI,KUBECTL,ADMINER_UI,EXPRESS_UI hostNodeStyle;
    class APIServer,Etcd,Scheduler,KCM,CCM controlPlane;
    class Kubelet1,KProxy1,CRI1,Kubelet2,KProxy2,CRI2,INGRESS workerNode;
    class Container1,Container2 pod;